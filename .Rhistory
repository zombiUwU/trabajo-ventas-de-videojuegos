ganancia_total_EU <- sum(prueba$EU_Sales)
ganancia_total_NA <- sum(prueba$NA_Sales)
ganancia_total_JP <- sum(prueba$JP_Sales)
ganancia_total_Other <- sum(prueba$Other_Sales)
ganancia_total_global <- sum(prueba)
