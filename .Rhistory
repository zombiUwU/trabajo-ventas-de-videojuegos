library(dplyr)
library(knitr)
library(kableExtra)
library(ggplot2)
library(tidyr)
library(here)
library(readr)
Data.informacion <- read_csv("video_games_sales corregido.csv")
generos <- c("Acción",
"Aventura",
"Carreras",
"Deportes",
"Disparos",
"Estrategia",
"Juegos de rol",
"Pelea",
"Plataforma",
"rompecabezas",
"Simulacion",
"Varios")
frame_genre <- frame_genre %>%
mutate(genre = generos)
### porcentaje de la frecuencia de los generos de videojuegos ###
total_genre <- sum(frame_genre$frecuencias_genre)
porcentaje_genero  <- frame_genre  %>%
mutate(porcentajes = frecuencias_genre / total_genre * 100) %>%
select(genre, frecuencias_genre, porcentajes) %>%
arrange(desc(porcentajes))
generos <- c("Acción",
"Aventura",
"Carreras",
"Deportes",
"Disparos",
"Estrategia",
"Juegos de rol",
"Pelea",
"Plataforma",
"rompecabezas",
"Simulacion",
"Varios")
frame_genre <- frame_genre %>%
mutate(genre = generos)
### porcentaje de la frecuencia de los generos de videojuegos ###
total_genre <- sum(frame_genre$frecuencias_genre)
porcentaje_genero  <- frame_genre  %>%
mutate(porcentajes = frecuencias_genre / total_genre * 100) %>%
select(genre, frecuencias_genre, porcentajes) %>%
arrange(desc(porcentajes))
porcentaje_genero %>%
kable("html",
col.names = c("Género", "Frecuencia", "Porcentaje (%)"),
digits = 2,
caption = "Frecuencia y Porcentaje de Géneros de Videojuegos") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE) %>%  # Estilo base: rayas y hover
row_spec(0, bold = TRUE, color = "white", background = "#4A90E2") %>%  # Cabecera: azul simple
row_spec(seq(1, nrow(porcentaje_genero), 2), background = "#F0F0F0")  # Filas impares: gris claro uniforme
### valores individuales de la data.infomacion ###
# cambio de variable de caracter a factor
Data.informacion$Genre <- as.factor(Data.informacion$Genre)
# agrupacion por genero
frecuencias_genre <- summary(Data.informacion$Genre)
frame_genre <-  data.frame(frecuencias_genre)
generos <- c("Acción",
"Aventura",
"Carreras",
"Deportes",
"Disparos",
"Estrategia",
"Juegos de rol",
"Pelea",
"Plataforma",
"rompecabezas",
"Simulacion",
"Varios")
frame_genre <- frame_genre %>%
mutate(genre = generos)
### porcentaje de la frecuencia de los generos de videojuegos ###
total_genre <- sum(frame_genre$frecuencias_genre)
porcentaje_genero  <- frame_genre  %>%
mutate(porcentajes = frecuencias_genre / total_genre * 100) %>%
select(genre, frecuencias_genre, porcentajes) %>%
arrange(desc(porcentajes))
porcentaje_genero %>%
kable("html",
col.names = c("Género", "Frecuencia", "Porcentaje (%)"),
digits = 2,
caption = "Frecuencia y Porcentaje de Géneros de Videojuegos") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE) %>%  # Estilo base: rayas y hover
row_spec(0, bold = TRUE, color = "white", background = "#4A90E2") %>%  # Cabecera: azul simple
row_spec(seq(1, nrow(porcentaje_genero), 2), background = "#F0F0F0")  # Filas impares: gris claro uniforme
### valores individuales de la data.infomacion ###
# cambio de variable de caracter a factor
Data.informacion$Genre <- as.factor(Data.informacion$Genre)
# agrupacion por genero
frecuencias_genre <- summary(Data.informacion$Genre)
frame_genre <-  data.frame(frecuencias_genre)
generos <- c("Acción",
"Aventura",
"Carreras",
"Deportes",
"Disparos",
"Estrategia",
"Juegos de rol",
"Pelea",
"Plataforma",
"rompecabezas",
"Simulacion",
"Varios")
frame_genre <- frame_genre %>%
mutate(genre = generos)
### porcentaje de la frecuencia de los generos de videojuegos ###
total_genre <- sum(frame_genre$frecuencias_genre)
porcentaje_genero  <- frame_genre  %>%
mutate(porcentajes = frecuencias_genre / total_genre * 100) %>%
select(genre, frecuencias_genre, porcentajes) %>%
arrange(desc(porcentajes))
porcentaje_genero %>%
kable("html",
col.names = c("Género", "Frecuencia", "Porcentaje (%)"),
digits = 2,
caption = "Frecuencia y Porcentaje de Géneros de Videojuegos") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE) %>%
row_spec(0, bold = TRUE, color = "white", background = "#4A90E2") %>%
row_spec(seq(1, nrow(porcentaje_genero), 2), background = "#F0F0F0")
# grafico
grafico_genre_videojuegos <- ggplot(data = porcentaje_genero, aes(x = porcentajes, y = reorder(genre, porcentajes))) +
geom_bar(stat = "identity",
fill = "steelblue",
width = 0.7) +
geom_text(aes(label = paste0(round(porcentajes, 1), "%")),
hjust = -0.1, size = 3.5, color = "black") +
labs(title = "Porcentaje de Frecuencia por Género de Videojuegos",
x = "Porcentaje",
y = "Género") +
theme_minimal() +
theme(axis.text.y = element_text(size = 10),
plot.title = element_text(hjust = 0.5, size = 14, face = "bold")) +
scale_x_continuous(limits = c(0, max(porcentaje_genero$porcentajes) * 1.1))
print()
print(grafico_genre_videojuegos)
